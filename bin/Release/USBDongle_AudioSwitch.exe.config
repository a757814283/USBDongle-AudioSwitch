<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <!-- Must match TargetFrameworkVersion in the .csproj. A mismatch (the
             scaffold shipped v3.5 here) makes the CLR activation shim fail with
             "This application could not be started." -->
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
</configuration>
